# macOS Samuel 1.3.1 · optional settings
# Copy to ~/Library/Application Support/Samuel/us_market_sentinel/.env
# Or configure directly inside Samuel → 宏观 / 设置 → 数据与模型设置.
# The environment of SamuelData takes precedence. Use a private file (chmod 600).
# When FRED_API_KEY is empty, Samuel automatically falls back to FRED's public CSV endpoint.
# Request a free FRED key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Analysis backend: api, agy, opencode, codex, or claude
SAMUEL_LLM_BACKEND=api

# Configure an HTTPS Chat Completions endpoint and a model available to your account (when backend=api).
# SAMUEL_LLM_API_KEY takes precedence over OPENAI_API_KEY.
SAMUEL_LLM_BASE_URL=https://api.openai.com/v1
SAMUEL_LLM_MODEL=
SAMUEL_LLM_API_KEY=
OPENAI_API_KEY=

# Optional model IDs and absolute paths for local CLI backends (leave blank to use default model / auto-detect path).
SAMUEL_AGY_MODEL=
SAMUEL_AGY_PATH=
SAMUEL_OPENCODE_MODEL=
SAMUEL_OPENCODE_PATH=
SAMUEL_CODEX_MODEL=
SAMUEL_CODEX_PATH=
SAMUEL_CLAUDE_MODEL=
SAMUEL_CLAUDE_PATH=

# left_dca or right_confirm
SAMUEL_SENTINEL_STYLE=left_dca
